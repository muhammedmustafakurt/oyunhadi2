# Neon bağlantı adresi. Boş bırakılırsa yerelde oyun odaları bellekte tutulur (sunucu kapanınca silinir).
DATABASE_URL=
# Panel oturum çerezini imzalayan gizli anahtar. Üretimde ZORUNLU, en az 32 karakter (ör. `openssl rand -hex 32`).
SESSION_SECRET=
# Karekodlardaki adresin başı (ör. https://oyunhadi.com). ÜRETİMDE ZORUNLU: boşsa karekod adresi isteğin Host/X-Forwarded-Host
# başlığından türetilir (sahte başlıkla yanlış adrese yönlendirilebilir). Yerelde boş bırakılabilir.
SITE_URL=
# WhatsApp butonu ve teklif formu için numara (ülke koduyla, ör. 905xxxxxxxxx)
NEXT_PUBLIC_WHATSAPP=
# Süper-admin ilk yönetici tohumu (yalnızca admins tablosu BOŞKEN kullanılır; ikisi de doldurulmazsa /admin girişi kapalı kalır).
# ADMIN_EMAIL: yönetici e-postası. ADMIN_PASSWORD_HASH: `node scripts/admin-hash.mjs` çıktısı (salt:hash). Düz şifre buraya YAZILMAZ.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
